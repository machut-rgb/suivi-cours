# SuiviApp — production environment template.
# Copy to .env.production (never commit it) and pass it with `docker run --env-file` / `docker compose`,
# or set the same variables in your hosting provider's dashboard.

APP_NAME=SuiviApp
APP_ENV=production
APP_DEBUG=false
# Generate with: docker run --rm suiviapp php artisan key:generate --show
APP_KEY=
APP_URL=https://suivi.example.fr
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

# "*" when behind a PaaS router / load balancer that terminates TLS; leave empty when exposed directly.
TRUSTED_PROXIES=*

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database -------------------------------------------------------------------
# Default: SQLite file inside the persistent storage volume (fine for a single school).
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/database/database.sqlite
# PostgreSQL / MySQL instead:
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=suiviapp
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Password-reset e-mails need a real SMTP server.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="suivi@example.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Container behaviour (docker/entrypoint.sh)
RUN_MIGRATIONS=true
SEED_DEMO_DATA=false
